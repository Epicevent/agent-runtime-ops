[Unit]
Description=Standalone root-action WebAuthn approval and execution broker
After=local-fs.target
ConditionPathIsDirectory=@@BROKER_RELEASE_DIR@@
ConditionFileIsExecutable=@@BROKER_RELEASE_DIR@@/.venv/bin/python
ConditionPathExists=/etc/agent-runtime-ops/root-action-webauthn.env

[Service]
Type=simple
User=root
Group=root
UMask=0027
WorkingDirectory=/
ExecStart=@@BROKER_RELEASE_DIR@@/.venv/bin/python -I -B -m agent_runtime_ops.root_actions.service
EnvironmentFile=/etc/agent-runtime-ops/root-action-webauthn.env
Environment=AGENT_RUNTIME_ROOT_ACTION_RELEASE=@@BROKER_RELEASE_DIR@@
Environment=AGENT_RUNTIME_ROOT_ACTION_SOURCE_COMMIT=@@SOURCE_COMMIT@@
Environment=AGENT_RUNTIME_ROOT_ACTION_TREE_SHA256=@@BROKER_TREE_SHA256@@
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
AmbientCapabilities=CAP_SETUID
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/agent-runtime-ops/root-actions /run/agent-runtime-ops
ReadOnlyPaths=/etc/agent-runtime-ops/root-action-webauthn.env @@BROKER_RELEASE_DIR@@
RestrictAddressFamilies=AF_UNIX
RuntimeDirectory=agent-runtime-ops
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
