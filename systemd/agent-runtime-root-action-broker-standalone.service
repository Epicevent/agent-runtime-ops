[Unit]
Description=Standalone root-action WebAuthn approval and execution broker
After=local-fs.target
ConditionPathIsDirectory=@@BROKER_RELEASE_DIR@@
ConditionPathIsFile=@@BROKER_DESCRIPTOR@@
ConditionPathIsFile=@@BROKER_LAUNCHER@@
ConditionPathIsFile=/etc/agent-runtime-ops/root-action-webauthn.env

[Service]
Type=simple
User=root
Group=root
UMask=0027
WorkingDirectory=/
ExecStart=/usr/bin/python3 -I -B -S @@BROKER_LAUNCHER@@ run --release-dir @@BROKER_RELEASE_DIR@@ --descriptor @@BROKER_DESCRIPTOR@@ --source-commit @@SOURCE_COMMIT@@ --descriptor-sha256 @@DESCRIPTOR_SHA256@@ --launcher-sha256 @@LAUNCHER_SHA256@@
EnvironmentFile=/etc/agent-runtime-ops/root-action-webauthn.env
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/agent-runtime-ops/root-actions /run/agent-runtime-ops
ReadOnlyPaths=/etc/agent-runtime-ops/root-action-webauthn.env @@BROKER_RELEASE_DIR@@ @@BROKER_DESCRIPTOR@@ @@BROKER_LAUNCHER@@
RestrictAddressFamilies=AF_UNIX
RuntimeDirectory=agent-runtime-ops
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
