[Unit]
Description=Agent Runtime root-action WebAuthn approval and execution broker
After=local-fs.target
ConditionPathIsDirectory=@@CURRENT_LINK@@
ConditionPathIsFile=/etc/agent-runtime-ops/root-action-webauthn.env

[Service]
Type=simple
User=root
Group=root
UMask=0027
ExecStart=@@CURRENT_LINK@@/.venv/bin/python -m agent_runtime_ops.root_actions.service
EnvironmentFile=/etc/agent-runtime-ops/root-action-webauthn.env
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/agent-runtime-ops/root-actions /run/agent-runtime-ops
ReadOnlyPaths=/etc/agent-runtime-ops/root-action-webauthn.env
RestrictAddressFamilies=AF_UNIX
RuntimeDirectory=agent-runtime-ops
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
